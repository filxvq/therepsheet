// A Worker that only serves the QC photos under /img/qc/*, shared by therepsheet.com and
// theweidianspreadsheet.com (same 1881 products). They live here, not in the site Workers, because
// ~19k files would push either one past Cloudflare's 20,000-file limit. Fill public/img/qc/ with
// `node scripts/qc.mjs`, then deploy with `npm run deploy:qc` from the repo root.
{
  "name": "rep-qc-img",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "not_found_handling": "none" },
  "routes": [
    { "pattern": "therepsheet.com/img/qc/*", "zone_name": "therepsheet.com" },
    { "pattern": "theweidianspreadsheet.com/img/qc/*", "zone_name": "theweidianspreadsheet.com" }
  ]
}
